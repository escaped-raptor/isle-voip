{
  "name": "isle-voip-server-app",
  "version": "0.3.0",
  "releaseStage": "Beta",
  "description": "Species Specific VoIP (The Isle Evrima) - server app",
  "license": "MIT",
  "author": "escaped-raptor",
  "repository": "github:escaped-raptor/isle-voip",
  "main": "main.js",
  "scripts": {
    "stage": "node build.mjs",
    "start": "electron .",
    "dist": "node build.mjs && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.escaped-raptor.isle-voip-server",
    "productName": "Species Specific VoIP Server (The Isle Evrima)",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/shared",
        "to": "shared"
      },
      {
        "from": "stage/client",
        "to": "client"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Species Specific VoIP Server (The Isle Evrima)",
      "uninstallDisplayName": "Species Specific VoIP Server (The Isle Evrima)",
      "artifactName": "Species-Specific-VoIP-Server-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    }
  }
}
