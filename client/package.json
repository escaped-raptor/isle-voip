{
  "name": "isle-voip-client",
  "version": "0.2.7",
  "releaseStage": "Alpha",
  "description": "Species Specific VoIP (The Isle Evrima) - player client",
  "license": "MIT",
  "author": "escaped-raptor",
  "repository": "github:escaped-raptor/isle-voip",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "mediasoup-client": "^3.7.17"
  },
  "build": {
    "appId": "io.github.escaped-raptor.isle-voip-client",
    "productName": "Species Specific VoIP (The Isle Evrima)",
    "files": [
      "main.js",
      "preload.js",
      "dist/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Your microphone is used to talk to other players in voice chat."
      },
      "icon": "build/icon.png"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Species Specific VoIP (The Isle Evrima)",
      "uninstallDisplayName": "Species Specific VoIP (The Isle Evrima)",
      "artifactName": "Species-Specific-VoIP-Setup-${version}.${ext}"
    },
    "publish": null
  }
}
